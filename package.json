{
  "name": "@linxin666/dsh-client-ui-skin-stock",
  "version": "1.5.0",
  "description": "股市行情皮肤+功能插件：从 Trading Terminal 皮肤演进而来的自选跑马灯、实时行情、自选列表与持仓盈亏面板，点击跑马灯弹出个股日K图（蜡烛/MA/成交量）（A股/港股/美股/指数/加密/外汇，腾讯+Binance+Yahoo+Frankfurter 聚合）",
  "author": "Jose AI (https://www.linhut.cn)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "web-ui",
    "skin",
    "stock",
    "trading",
    "ticker",
    "watchlist",
    "positions",
    "行情",
    "自选",
    "持仓",
    "跑马灯"
  ],
  "files": [
    "lib",
    "skin.json",
    "cordis.patch.yml",
    "screenshots.json",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "echo 本插件为手写无构建产物；直接发布 lib/ 即可",
    "prepare": "node tools/verify-pack.mjs",
    "verify": "node tools/verify-pack.mjs",
    "check:compliance": "node tools/check-dsh-compliance.mjs",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/linhut/dsh-stock-terminal.git"
  }
}
